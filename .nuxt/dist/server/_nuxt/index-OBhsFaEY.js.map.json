/error.js\";\nconst intervalError = \"[nuxt] `setInterval` should not be used on the server. Consider wrapping it with an `onNuxtReady`, `onBeforeMount` or `onMounted` lifecycle hook, or ensure you only call it in the browser by checking `import.meta.client`.\";\nexport const setInterval = import.meta.client ? window.setInterval : () => {\n  if (import.meta.dev) {\n    throw createError({\n      statusCode: 500,\n      message: intervalError\n    });\n  }\n  console.error(intervalError);\n};\n","<template>\r\n  <div class=\"relative w-full h-screen overflow-hidden\">\r\n    <!-- Video Slider -->\r\n    <div\r\n      ref=\"sliderRef\"\r\n      class=\"relative flex w-full h-full transition-transform duration-[2100ms] ease-in-out\"\r\n      :style=\"carouselStyle\"\r\n    >\r\n      <div\r\n        v-for=\"(video, index) in videos\"\r\n        :key=\"index\"\r\n        class=\"relative w-full h-full flex-none\"\r\n      >\r\n        <!-- Video -->\r\n        <video\r\n          :src=\"video.src\"\r\n          class=\"absolute top-0 left-0 w-full h-full object-cover\"\r\n          autoplay\r\n          muted\r\n          loop\r\n        ></video>\r\n\r\n        <!-- Overlay -->\r\n        <div class=\"absolute inset-0 bg-black bg-opacity-50\"></div>\r\n\r\n        <!-- Text Content -->\r\n        <div\r\n          v-if=\"currentIndex === index\"\r\n          class=\"absolute inset-0 flex flex-col items-center justify-center text-center text-white px-4\"\r\n        >\r\n          <h1 class=\"text-4xl md:text-6xl font-extrabold mb-4 animate-fade-in\">\r\n            {{ video.text }}\r\n          </h1>\r\n          <p class=\"text-lg md:text-xl font-medium animate-fade-in delay-200\">\r\n            {{ video.subText }}\r\n          </p>\r\n\r\n          <!-- Buttons -->\r\n          <div class=\"mt-6 space-x-4 animate-fade-in delay-400\">\r\n            <button\r\n              class=\"px-6 py-3 bg-green-500 hover:bg-transparent text-white font-semibold rounded-lg transition-colors duration-300\"\r\n              @click=\"navigateTo('services')\"\r\n            >\r\n              Services\r\n            </button>\r\n            <button\r\n              class=\"px-6 py-3 bg-orange-400 hover:bg-transparent text-white font-semibold rounded-lg transition-colors duration-300\"\r\n              @click=\"navigateTo('about-us')\"\r\n            >\r\n              About Us\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Navigation Buttons -->\r\n    <button\r\n      @click=\"onPrev\"\r\n      class=\"absolute left-4 top-1/2 -translate-y-1/2 text-white text-2xl hover:transform hover:-translate-x-2 transition-all duration-300 z-10\"\r\n      aria-label=\"Previous\"\r\n    >\r\n      ←\r\n      <span\r\n        class=\"absolute inset-y-0 left-0 w-0 h-0.5 bg-white group-hover:w-4 transition-all duration-300\"\r\n      ></span>\r\n    </button>\r\n\r\n    <button\r\n      @click=\"onNext\"\r\n      class=\"absolute right-4 top-1/2 -translate-y-1/2 text-white text-2xl hover:transform hover:translate-x-2 transition-all duration-300 z-10\"\r\n      aria-label=\"Next\"\r\n    >\r\n      →\r\n      <span\r\n        class=\"absolute inset-y-0 right-0 w-0 h-0.5 bg-white group-hover:w-4 transition-all duration-300\"\r\n      ></span>\r\n    </button>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { ref, computed, onMounted } from \"vue\";\r\n\r\n// Array to define the videos and their respective text content\r\nconst videos = [\r\n  {\r\n    src: \"/videos/green.mp4\", // Local video path\r\n    text: \"Welcome to Our Play Group!\", // Main heading\r\n    subText: \"Learn. Play. Grow.\", // Subheading\r\n  },\r\n  {\r\n    src: \"/videos/blue.mp4\", // Local video path\r\n    text: \"Redefined African Mobile Solutions!\", // Main heading\r\n    subText: \"Where imagination meets reality.\", // Subheading\r\n  },\r\n  {\r\n    src: \"/videos/orange.mp4\", // Local video path\r\n    text: \"Fostering Innovation!\", // Main heading\r\n    subText: \"Let's explore and create together.\", // Subheading\r\n  },\r\n];\r\n\r\nconst currentIndex = ref(0);\r\n\r\n// Style for the carousel sliding effect\r\nconst carouselStyle = computed(() => ({\r\n  transform: `translateX(-${currentIndex.value * 100}%)`,\r\n}));\r\n\r\n// Navigate to the previous slide\r\nfunction onPrev() {\r\n  currentIndex.value = (currentIndex.value - 1 + videos.length) % videos.length;\r\n}\r\n\r\n// Navigate to the next slide\r\nfunction onNext() {\r\n  currentIndex.value = (currentIndex.value + 1) % videos.length;\r\n}\r\n\r\n// Navigation functionality for buttons\r\nfunction navigateTo(section: string) {\r\n  if (section === \"services\") {\r\n    // Navigate to services section\r\n    window.location.href = \"/services\";\r\n  } else if (section === \"about-us\") {\r\n    // Navigate to about us section\r\n    window.location.href = \"/about-us\";\r\n  }\r\n}\r\n\r\n// Autoplay functionality\r\nlet autoplayInterval: number | null = null;\r\n\r\nfunction startAutoplay() {\r\n  autoplayInterval = setInterval(() => {\r\n    onNext();\r\n  }, 15000); // Change slides every 15 seconds\r\n}\r\n\r\nfunction stopAutoplay() {\r\n  if (autoplayInterval) {\r\n    clearInterval(autoplayInterval);\r\n    autoplayInterval = null;\r\n  }\r\n}\r\n\r\n// Start autoplay on component mount\r\nonMounted(() => {\r\n  startAutoplay();\r\n});\r\n</script>\r\n\r\n<style scoped>\r\n/* Tailwind Animations */\r\n@keyframes fade-in {\r\n  0% {\r\n    opacity: 0;\r\n    transform: translateY(10px);\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n.animate-fade-in {\r\n  animation: fade-in 1s ease forwards;\r\n}\r\n\r\n.animate-fade-in.delay-200 {\r\n  animation-delay: 0.2s;\r\n}\r\n\r\n.animate-fade-in.delay-400 {\r\n  animation-delay: 0.4s;\r\n}\r\n</style>\r\n","export default \"__VITE_ASSET__ZFxe8XDI__\"","export default \"__VITE_ASSET__BJhqbwu5__\"","<template>\r\n  <section class=\"bg-green-100\">\r\n    <div\r\n      class=\"gap-16 items-center py-8 px-4 mx-auto max-w-screen-xl lg:grid lg:grid-cols-2 lg:py-16 lg:px-6\"\r\n    >\r\n      <div class=\"font-light text-black sm:text-lg\">\r\n        <h2\r\n          class=\"mb-4 text-4xl tracking-tight font-semibold text-black font-sans\"\r\n        >\r\n          Transforming Mobile Experiences\r\n          <span class=\"text-orange-400\">Across Africa</span>\r\n        </h2>\r\n\r\n        <p class=\"mb-4\">\r\n          At The Play Group, we are pioneers in mobile content, innovators in\r\n          digital solutions, and passionate advocates for transformative\r\n          engagement. Our journey spans over a decade, delivering cutting-edge\r\n          mobile entertainment, health solutions, gaming, and startup incubation\r\n          services.\r\n        </p>\r\n        <p>\r\n          We collaborate with partners across the globe to redefine digital\r\n          engagement, providing unique solutions that entertain, inform, and\r\n          empower millions across Africa and beyond.\r\n        </p>\r\n      </div>\r\n      <div class=\"grid grid-cols-2 gap-4 mt-8\">\r\n        <img\r\n          class=\"w-full h-auto lg:h-72 rounded-lg\"\r\n          src=\"/assets/images/boost.jpg\"\r\n          alt=\"Placeholder for The Play Group image 1\"\r\n        />\r\n        <img\r\n          class=\"mt-4 w-full h-auto lg:mt-10 lg:h-72 rounded-lg\"\r\n          src=\"/assets/images/telco.jpg\"\r\n          alt=\"Placeholder for The Play Group image 2\"\r\n        />\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n","<template>\r\n    <section class=\"py-10 bg-white sm:py-16 lg:py-24\">\r\n      <div class=\"px-4 mx-auto max-w-7xl sm:px-6 lg:px-8\">\r\n        <div class=\"text-center\">\r\n          <h2 class=\"text-xl font-medium text-gray-900\">\r\n            Numbers that highlight our journey at The Play Group\r\n          </h2>\r\n        </div>\r\n  \r\n        <dl class=\"mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 sm:mt-8\">\r\n          <!-- Years of Experience -->\r\n          <div class=\"flex flex-col px-4 py-8 text-center border-l border-gray-200 first:border-none\">\r\n            <dt class=\"order-last text-lg font-medium text-gray-500\">Years of Experience</dt>\r\n            <dd class=\"text-4xl font-semibold text-black md:text-5xl\">\r\n              {{ yearsExperience }}<span class=\"text-orange-400\">+</span>\r\n            </dd>\r\n          </div>\r\n  \r\n          <!-- Countries Served -->\r\n          <div class=\"flex flex-col px-4 py-8 text-center border-l border-gray-200\">\r\n            <dt class=\"order-last text-lg font-medium text-gray-500\">Countries Served</dt>\r\n            <dd class=\"text-4xl font-semibold text-black md:text-5xl\">\r\n              {{ countriesServed }}<span class=\"text-orange-400\">+</span>\r\n            </dd>\r\n          </div>\r\n  \r\n          <!-- Mobile Solutions -->\r\n          <div class=\"flex flex-col px-4 py-8 text-center border-l border-gray-200\">\r\n            <dt class=\"order-last text-lg font-medium text-gray-500\">Mobile Solutions</dt>\r\n            <dd class=\"text-4xl font-semibold text-black md:text-5xl\">\r\n              {{ mobileSolutions }}<span class=\"text-orange-400\">+</span>\r\n            </dd>\r\n          </div>\r\n  \r\n          <!-- Strategic Partnerships -->\r\n          <div class=\"flex flex-col px-4 py-8 text-center border-l border-gray-200\">\r\n            <dt class=\"order-last text-lg font-medium text-gray-500\">Strategic Partnerships</dt>\r\n            <dd class=\"text-4xl font-semibold text-black md:text-5xl\">\r\n              {{ strategicPartnerships }}<span class=\"text-orange-400\">+</span>\r\n            </dd>\r\n          </div>\r\n        </dl>\r\n      </div>\r\n    </section>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    data() {\r\n      return {\r\n        yearsExperience: 0,\r\n        countriesServed: 0,\r\n        mobileSolutions: 0,\r\n        strategicPartnerships: 0,\r\n      };\r\n    },\r\n    mounted() {\r\n      // Start counting for each metric\r\n      this.animateCountUp(\"yearsExperience\", 14);\r\n      this.animateCountUp(\"countriesServed\", 20);\r\n      this.animateCountUp(\"mobileSolutions\", 10);\r\n      this.animateCountUp(\"strategicPartnerships\", 15);\r\n    },\r\n    methods: {\r\n      animateCountUp(key, target) {\r\n        let count = 0;\r\n        const interval = setInterval(() => {\r\n          if (count < target) {\r\n            count++;\r\n            this[key] = count;\r\n          } else {\r\n            clearInterval(interval);\r\n          }\r\n        }, 100); // Adjust speed of counting\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* Styling changes */\r\n  dl {\r\n    display: grid;\r\n  }\r\n  \r\n  .border-l:first-of-type {\r\n    border-left: none; /* Remove border on the first column */\r\n  }\r\n  \r\n  .text-blue-600 {\r\n    font-family: \"Inter\", sans-serif; /* Change font to thinner and cleaner style */\r\n    font-weight: 600; /* Semi-bold weight */\r\n  }\r\n  </style>\r\n  ","<template>\r\n  <section class=\"w-full px-6 py-12 mx-auto lg:py-16 bg-blue-100\">\r\n    <h3\r\n      class=\"font-serif text-3xl text-black capitalize md:text-4xl lg:text-5xl text-center\"\r\n    >\r\n      Explore Our Dynamic Offerings\r\n    </h3>\r\n    <p class=\"text-center text-gray-600 mb-4\">\r\n      Delve into our diverse range of mobile-centric services, each crafted to\r\n      elevate engagement, entertain, and inform your global audience.\r\n    </p>\r\n    <div class=\"mt-8 xl:flex xl:justify-center xl:gap-8\">\r\n      <!-- Highlighted Service -->\r\n      <div class=\"xl:w-1/2\">\r\n        <img\r\n          class=\"object-cover w-full h-96\"\r\n          src=\"https://via.placeholder.com/800x450\"\r\n          alt=\"Mobile Infotainment Services\